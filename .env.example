# Copie para .env (cp .env.example .env) e preencha. O .env guarda segredos e
# não vai para o Git (.gitignore) nem para as imagens Docker (.dockerignore).

# Onde fica o servidor PostgreSQL:
#   local → PostgreSQL em contêiner na própria máquina
#   gcp   → Cloud SQL for PostgreSQL, acessado pelo Cloud SQL Auth Proxy
COMPOSE_PROFILES=local

# Somente no perfil gcp: nome de conexão da instância Cloud SQL, no formato
# PROJETO:REGIAO:INSTANCIA (Console > SQL > instância > "Nome da conexão").
CLOUD_SQL_INSTANCIA=

# Senhas do banco. Para gerar uma senha:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#   openssl rand -hex 24
# Senha do usuário administrador "postgres". No perfil gcp, é a definida em
# --root-password ao criar a instância Cloud SQL. Usada só para criar os bancos.
DB_ADMIN_SENHA=
# Senha do usuário conta_app (banco fintech_contas, usado pelo conta-service).
DB_CONTAS_SENHA=
# Senha do usuário pagamento_app (banco fintech_pagamentos, usado pelo pagamento-service).
DB_PAGAMENTOS_SENHA=

# Chave que assina os tokens JWT (mínimo de 32 caracteres). Para gerar uma:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
JWT_SEGREDO=
JWT_EXPIRACAO_MINUTOS=30

# Origens que o CORS do gateway aceita, separadas por vírgula.
# Na VM do Google Cloud: https://IP_PUBLICO_DA_VM
CORS_ORIGENS=https://localhost

# Nome ou IP gravado no certificado HTTPS autoassinado gerado pelo nginx.
# Na VM do Google Cloud: o IP público (ex.: 34.123.45.67)
DOMINIO_CERTIFICADO=localhost

# Portas publicadas pelo nginx.
PORTA_HTTP=80
PORTA_HTTPS=443

# Somente no perfil local: porta do PostgreSQL em 127.0.0.1, para DBeaver/pgAdmin.
# A 15432 evita conflito com um PostgreSQL instalado na máquina e com as faixas de
# portas que o Windows (Hyper-V/WSL) costuma reservar perto da 5432.
PORTA_BANCO_LOCAL=15432

# Swagger UI do gateway em /api/docs (true ou false).
DOCS_HABILITADA=true
